    },
    {
      "id": "8d9d2efb-510b-46ef-a6ce-099acc4fccc5",
      "name": "Offres trouvées",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "jsCode": "// Transforme la réponse de GET /search en une offre par item, ou en un item « none » (aucune offre / erreur).\nconst r = $input.first().json;\nif (r.error || !Array.isArray(r.offers)) {\n  const detail = r.error ? (r.error.message || JSON.stringify(r.error)) : JSON.stringify(r);\n  return [{ json: { none: true, text: '⚠️ Recherche Indeed impossible : ' + String(detail).slice(0, 300) } }];\n}\nif (!r.offers.length) {\n  return [{ json: { none: true, text: '🔎 Aucune offre trouvée sur Indeed pour ' + (r.default_query ? 'les métiers de l’IA' : '« ' + r.q + ' »') + (Number(r.days) === 1 ? ' dans les dernières 24 heures.' : ' dans les ' + r.days + ' derniers jours.') } }];\n}\nreturn r.offers.map((o, i) => ({ json: { ...o, index: i + 1, total: r.offers.length } }));\n"
      }
    },
    {
      "id": "212af899-16c6-4c7b-9e66-7f525faba554",
      "name": "Aucune offre ?",

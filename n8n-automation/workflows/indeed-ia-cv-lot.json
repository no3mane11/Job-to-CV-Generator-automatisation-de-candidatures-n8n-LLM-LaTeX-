      "id": "57586c6d-e352-448b-a06d-e9d66886278a",
      "name": "Rechercher offres Indeed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        240,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://host.docker.internal:8000/search?days=' + encodeURIComponent($json.query.days || 3) + '&max=' + encodeURIComponent($json.query.max || 3) + ($json.query.q ? '&q=' + encodeURIComponent($json.query.q) : '') }}",
        "options": {

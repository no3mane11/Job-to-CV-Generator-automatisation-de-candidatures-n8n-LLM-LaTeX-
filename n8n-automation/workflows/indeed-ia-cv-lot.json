    {
      "id": "b7ed5cd4-05cc-4377-8d5f-30959ee3663b",
      "name": "Générer CV + lettre",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        1200,
        580
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'http://127.0.0.1:5678/webhook/' + (String($('Déclencheur').first().json.query.mode || '') === 'demo' ? 'generate-cv-demo' : 'generate-cv') + '?deliver=batch&url=' + encodeURIComponent($json.url) }}",
        "options": {
          "timeout": 600000
        }
      }
    },
    {
      "id": "a1d8e7ff-6be5-4bfd-95d8-81eb6c54678d",
      "name": "Résultat offre",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        580
      ],
      "parameters": {
        "jsCode": "// Associe l'offre traitée (métadonnées Indeed) au résultat du générateur, ou à l'erreur rencontrée.\nreturn $input.all().map((item, index) => {\n  const offer = $('Une offre à la fois').itemMatching(index).json;\n  const j = item.json;\n  if (j.error || typeof j.cv_latex !== 'string' || typeof j.cover_letter !== 'string') {\n    const err = j.error ? (j.error.message || JSON.stringify(j.error)) : 'réponse du générateur incomplète';\n    return { json: { ...offer, ok: false, error: String(err).slice(0, 300) }, pairedItem: { item: index } };\n  }\n  return { json: { ...j, ...offer, ok: true }, pairedItem: { item: index } };\n});\n"
      }
    },
    {
      "id": "2b5b1762-cb19-427e-aa56-8ec96a68da85",
      "name": "Préparer envoi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "jsCode": "// Prépare l'envoi groupé : un récapitulatif + un message par offre (lien Indeed, score ATS, lettre).\nconst DEMO_BANNER = \"🎓 DÉMO ACADÉMIQUE — CV FICTIF, NE PAS ENVOYER À UN RECRUTEUR\";\nconst GROQ_ALERT = \"⚠️⚠️ GÉNÉRÉ PAR LE MODÈLE DE SECOURS (Gemini indisponible) — VÉRIFIE CHAQUE AFFIRMATION AVANT D'ENVOYER ⚠️⚠️\";\nconst demo = String($('Déclencheur').first().json.query.mode || '') === 'demo';\nconst esc = (s) => String(s ?? '').replace(/([_*`\\[])/g, '\\\\$1');\nconst results = $input.all().map((i) => i.json);\nconst ok = results.filter((j) => j.ok);\n\nconst recap = [(demo ? DEMO_BANNER + '\\n\\n' : '') + '📬 *Offres IA Indeed — derniers jours*',\n  ok.length + ' offre(s) traitée(s) sur ' + results.length + '.', ''];\nresults.forEach((j, i) => {\n  const score = j.ok && j.keyword_scores ? ' · ATS ' + (j.keyword_scores.overall_keyword_match_score ?? '—') + '%' : '';\n  recap.push((i + 1) + '. ' + (j.ok ? '✅ ' : '❌ ') + esc(j.job_title) + ' — ' + esc(j.company)\n    + ' (' + esc(j.location) + ', ' + esc(j.posted) + ')' + score + '\\n' + j.url + (j.ok ? '' : '\\n   échec : ' + esc(j.error)));\n});\n\nreturn results.map((j, i) => {\n  const head = (demo ? DEMO_BANNER + '\\n\\n' : '') + (j.generated_by === 'groq' ? GROQ_ALERT + '\\n\\n' : '')\n    + '*' + (i + 1) + '/' + results.length + ' — ' + esc(j.job_title) + '* — ' + esc(j.company) + '\\n'\n    + '📍 ' + esc(j.location) + ' · publiée : ' + esc(j.posted) + '\\n🔗 ' + j.url;\n  let message;\n  if (!j.ok) {\n    message = head + '\\n\\n❌ Échec du traitement : ' + esc(j.error);\n  } else {\n    const tail = '\\n\\n_(généré via ' + j.generated_by + ')_';\n    let letter = esc(j.cover_letter);\n    const base = head + '\\n\\n' + (j.telegram_report || '') + '\\n\\n';\n    if ((base + letter + tail).length > 4000) letter = letter.slice(0, 3990 - base.length - tail.length) + ' […]';\n    message = base + letter + tail;\n  }\n  return { json: { ...j, recap: recap.join('\\n'), message }, pairedItem: { item: i } };\n});\n"
      }
    },
